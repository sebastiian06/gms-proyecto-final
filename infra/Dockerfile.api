# Stage 1: Build
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app

# Necesitamos el código de gms-api. Asumimos que el docker-compose lo montará o copiará.
# Para mantener el repositorio independiente, usaremos un volumen en docker-compose o
# simplemente asumiremos que el contexto de build es la carpeta gms-api.
# NOTA: Como estamos en gms-infra, el docker-compose hará el build desde ../gms-api.

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN ./mvnw dependency:go-offline -B

COPY src ./src
RUN ./mvnw clean package -DskipTests

# Stage 2: Run
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]